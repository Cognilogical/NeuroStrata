{
  "version": 1,
  "suites": {
    "secret-precision": {
      "commands": [
        "cargo test --locked --bin neurostrata-mcp secrets::tests -- --test-threads=1",
        "cargo test --locked --bin neurostrata-mcp parser::ingest::tests -- --test-threads=1 --skip ingest_memory_probe",
        "cargo test --locked --bin neurostrata-mcp ingest_jobs::tests -- --test-threads=1"
      ],
      "tests": [
        "secrets::tests::secret_source_expression_matrix",
        "secrets::tests::placeholder_wrapped_token_rejected",
        "ingest_jobs::tests::progress_counts_skipped_files_without_echoing_a_secret",
        "parser::ingest::tests::clean_markdown_ingests"
      ],
      "thresholds": {
        "clean_shapes_no_false_skip": 20,
        "seeded_secrets_rejected": 12,
        "wrapped_tokens_rejected": 2,
        "comment_config_literals_rejected": 2,
        "ignored": 0
      }
    },
    "ingest-skip": {
      "commands": [
        "cargo test --locked --bin neurostrata-mcp parser::ingest::tests -- --test-threads=1 --skip ingest_memory_probe"
      ],
      "tests": [
        "parser::ingest::tests::skipped_fixture_does_not_force_new_generation"
      ],
      "thresholds": {
        "unchanged_ingests": 5,
        "generation_count": 1,
        "ignored": 0
      }
    },
    "lexical-generation": {
      "commands": [
        "cargo test --locked --bin neurostrata-mcp lexical::tests -- --test-threads=1",
        "cargo test --locked --bin neurostrata-mcp store::ladybug::tests -- --test-threads=1"
      ],
      "tests": [
        "store::ladybug::tests::lexical_search_returns_only_active_generation",
        "store::ladybug::tests::deleted_path_absent_from_lexical",
        "store::ladybug::tests::secret_skipped_absent_from_lexical",
        "store::ladybug::tests::lexical_owner_parity",
        "store::ladybug::tests::legacy_namespace_pointer_without_source_stamp_stays_visible",
        "store::ladybug::tests::scoped_row_without_any_pointer_stays_searchable",
        "store::ladybug::tests::staged_rows_cannot_starve_the_inhouse_page",
        "lexical::tests::validity_boundary_parity",
        "lexical::tests::rebuild_scoped_rejects_foreign_namespace",
        "lexical::tests::e1_code_token_breadth",
        "lexical::tests::e3_seeded_unicode_returns",
        "lexical::tests::archived_and_validity_starvation",
        "store::ladybug::tests::archiving_an_active_scoped_row_refreshes_the_inhouse_cache"
      ],
      "thresholds": {
        "unexpected_current_ids": 0,
        "deleted_rows": 0,
        "secret_skipped_rows": 0,
        "route_id_sets_equal": 1,
        "ignored": 0
      }
    },
    "guard-3000": {
      "commands": [
        "cargo test --locked --bin neurostrata-mcp guard:: -- --test-threads=1"
      ],
      "tests": [
        "guard::tests::three_thousand_rules_within_budget",
        "guard::tests::listing_cap_is_honored"
      ],
      "thresholds": {
        "rules": 3000,
        "p95_ms": 750,
        "max_ratio_to_100_rules": 2.0,
        "listing_cap": 5000,
        "ignored": 0
      }
    },
    "store-growth": {
      "commands": [
        "cargo test --locked --bin neurostrata-mcp parser::ingest::tests -- --test-threads=1 --skip ingest_memory_probe"
      ],
      "tests": [
        "parser::ingest::tests::store_growth_bounded_over_unchanged_ingests"
      ],
      "thresholds": {
        "unchanged_ingests": 5,
        "max_bytes_over_baseline_percent": 10,
        "generation_count": 1,
        "ignored": 0
      }
    },
    "hygiene-repair": {
      "commands": [
        "cargo test --locked --bin neurostrata-mcp store::ladybug::tests -- --test-threads=1",
        "cargo test --locked --bin neurostrata-mcp server::tests::caller_does_not_advance_on_error -- --test-threads=1"
      ],
      "tests": [
        "store::ladybug::tests::chunk_failure_keeps_prior_counts",
        "store::ladybug::tests::repair_partial_counts_are_reported",
        "store::ladybug::tests::hygiene_paging_pin",
        "server::tests::caller_does_not_advance_on_error"
      ],
      "thresholds": {
        "partial_counts_reported": 1,
        "failed_chunks_swallowed": 0,
        "watermark_advanced_on_error": 0,
        "ignored": 0
      }
    }
  }
}
