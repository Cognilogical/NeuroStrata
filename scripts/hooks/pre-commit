#!/bin/bash
# NeuroStrata pre-commit hook — scaffolded by neurostrata-bootstrap.
#
# Records the files/prefixes touched by this commit into `.NeuroStrata/session_queries.json`
# and stamps `graph_queried` on the active in_progress task for the namespace.
# Works across any repository layout (src/, pkg/, cmd/, apps/, packages/, scripts/, root files).
#
# Install with:  neurostrata-mcp hooks install

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
LEDGER="$ROOT/.NeuroStrata/session_queries.json"
NAMESPACE=""
if [ -f "$LEDGER" ]; then
    NAMESPACE=$(grep -o '"namespace"[[:space:]]*:[[:space:]]*"[^"]*"' "$LEDGER" | head -n1 | sed 's/.*"namespace"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
fi
if [ -z "$NAMESPACE" ]; then
    NAMESPACE=$(basename "$ROOT")
fi

# ── Collect staged file paths (excluding .NeuroStrata/ internal files) ───────
StagedFiles=()
while IFS= read -r -d '' file; do
    case "$file" in
        .NeuroStrata/*|"") ;;
        *) StagedFiles+=("$file") ;;
    esac
done < <(git diff --name-only -z --cached 2>/dev/null)
if [ "${#StagedFiles[@]}" -eq 0 ]; then
    while IFS= read -r -d '' file; do
        case "$file" in
            .NeuroStrata/*|"") ;;
            *) StagedFiles+=("$file") ;;
        esac
    done < <(git diff --name-only -z 2>/dev/null)
fi

# ── Check each staged file / ancestor dir-prefix against session_queries.json ──
for file in "${StagedFiles[@]}"; do
    matched=0
    if [ -f "$LEDGER" ]; then
        if grep -qF "\"$file\"" "$LEDGER" 2>/dev/null; then
            matched=1
        else
            # Walk ancestor directories of $file; only match if the exact
            # ancestor path was recorded in $LEDGER (not widened to top-level).
            anc=$(dirname "$file")
            while [ "$anc" != "." ] && [ "$anc" != "/" ] && [ -n "$anc" ]; do
                if grep -qF "\"$anc/\"" "$LEDGER" 2>/dev/null; then
                    matched=1
                    break
                fi
                anc=$(dirname "$anc")
            done
        fi
    fi
    if [ "$matched" -eq 0 ]; then
        echo "warning: file '$file' has no recorded NeuroStrata graph/memory lookup in this session" >&2
        echo "  → call: neurostrata_memories_for_file --namespace $NAMESPACE --path \"$file\"" >&2
    fi
done

# ── Write the query ledger (non-blocking, always writes) ─────────────────────
mkdir -p "$(dirname "$LEDGER")"
if [ ! -f "$LEDGER" ]; then
    printf '{\n  "namespace": "%s",\n  "queries": [\n  ]\n}\n' "$NAMESPACE" > "$LEDGER"
fi
for file in "${StagedFiles[@]}"; do
    if grep -qF "\"$file\"" "$LEDGER" 2>/dev/null; then
        continue
    fi
    TS=$(date +%s)
    # JSON-safe append: never interpolate $file into a sed replacement
    # string (where & or | would corrupt the JSON). Prefer node, fall back
    # to python3, then to an awk escape that reads ENVIRON["FILE"].
    export LEDGER NAMESPACE FILE="$file" TS
    if command -v node >/dev/null 2>&1; then
        node -e '
          const fs = require("fs");
          const ledger = process.env.LEDGER;
          const ns = process.env.NAMESPACE;
          const file = process.env.FILE;
          const ts = parseInt(process.env.TS, 10) || 0;
          let doc = { namespace: ns, queries: [] };
          try {
            const raw = fs.readFileSync(ledger, "utf8");
            doc = JSON.parse(raw);
          } catch {}
          if (!Array.isArray(doc.queries)) doc.queries = [];
          if (doc.queries.some((q) => q.query === file)) { process.exit(0); }
          doc.queries.push({ ts, tool: "pre-commit", query: file, domains: [file], returned_ids: [], governed_prefixes: [file] });
          fs.writeFileSync(ledger, JSON.stringify(doc, null, 2));
        ' 2>/dev/null || true
    elif command -v python3 >/dev/null 2>&1; then
        python3 -c '
          import json, os, sys
          ledger = os.environ["LEDGER"]
          ns = os.environ["NAMESPACE"]
          file = os.environ["FILE"]
          ts = int(os.environ.get("TS", "0") or "0")
          try:
            with open(ledger) as f:
              doc = json.load(f)
          except Exception:
            doc = {}
          if not isinstance(doc, dict):
            doc = {}
          if not isinstance(doc.get("queries"), list):
            doc["queries"] = []
          if any(isinstance(q, dict) and q.get("query") == file for q in doc["queries"]):
            sys.exit(0)
          doc["queries"].append({"ts": ts, "tool": "pre-commit", "query": file, "domains": [file], "returned_ids": [], "governed_prefixes": [file]})
          with open(ledger, "w") as f:
            json.dump(doc, f, indent=2)
        ' 2>/dev/null || true
    else
        TMP=$(mktemp)
        awk -v ns="$NAMESPACE" -v file="$file" -v ts="$TS" '
          function print_entry(comma) {
            print "    {"
            print "      \"ts\": " ts ","
            print "      \"tool\": \"pre-commit\","
            print "      \"query\": \"" file "\","
            print "      \"domains\": [\"" file "\"],"
            print "      \"returned_ids\": [],"
            print "      \"governed_prefixes\": [\"" file "\"]"
            if (comma) {
              print "    },"
            } else {
              print "    }"
            }
          }
          BEGIN {
            gsub(/\\/, "\\\\", file)
            gsub(/"/, "\\\"", file)
            found = 0
            inserted = 0
            pending_open = 0
          }
          {
            if (index($0, "\"" file "\"") > 0) found = 1
            if (pending_open) {
              if ($0 ~ /^[[:space:]]*\]/) {
                print_entry(0)
                print $0
                inserted = 1
                pending_open = 0
                next
              } else if ($0 ~ /^[[:space:]]*$/) {
                print $0
                next
              } else {
                print_entry(1)
                print $0
                inserted = 1
                pending_open = 0
                next
              }
            }
            if (!inserted && !found && $0 ~ /"queries"[[:space:]]*:[[:space:]]*\[/) {
              if ($0 ~ /\[[[:space:]]*\][[:space:]]*,?[[:space:]]*$/) {
                has_trailing_comma = ($0 ~ /\][[:space:]]*,[[:space:]]*$/)
                sub(/\[[[:space:]]*\][[:space:]]*,?[[:space:]]*$/, "[", $0)
                print $0
                print_entry(0)
                print (has_trailing_comma ? "  ]," : "  ]")
                inserted = 1
                next
              } else if ($0 ~ /\[[[:space:]]*\{/) {
                idx = index($0, "[")
                print substr($0, 1, idx)
                print_entry(1)
                rest = substr($0, idx + 1)
                sub(/^[[:space:]]*/, "", rest)
                print "    " rest
                inserted = 1
                next
              } else {
                print $0
                pending_open = 1
                next
              }
            }
            print
          }
          END {
            if (found) exit
            if (pending_open && !inserted) {
              print_entry(0)
              print "  ]"
              inserted = 1
            }
            if (!inserted) {
              print "{"
              print "  \"namespace\": \"" ns "\","
              print "  \"queries\": ["
              print_entry(0)
              print "  ]"
              print "}"
            }
          }
        ' "$LEDGER" > "$TMP" 2>/dev/null && mv "$TMP" "$LEDGER" || rm -f "$TMP"
    fi
done

exit 0
