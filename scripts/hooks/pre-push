#!/bin/bash
# NeuroStrata task gate — scaffolded by neurostrata-bootstrap / task_setup.
#
# The hook IS the gate. It runs on every push on ANY git host, so it is the
# required default; CI is vendor-specific and only a defense-in-depth extra.
# Install once with:  bash scripts/install-hooks.sh
# (`neurostrata-mcp hooks install` writes these exact bytes into the
# directory git actually runs hooks from, core.hooksPath honored — one
# hook text for both install paths, so they cannot drift.)

command -v neurostrata-mcp >/dev/null 2>&1 || { echo "error: neurostrata-mcp not found — gate NOT run for this push" >&2; exit 1; }
if [ "$NEUROSTRATA_SKIP_GATE" = "1" ]; then
    echo "NeuroStrata task gate: skipped (NEUROSTRATA_SKIP_GATE=1) — the gate did NOT run for this push" >&2
    exit 0
fi

# The namespaces this push must pass the gate for, worked out in one call
# from the refs git hands this hook on stdin: the folder name (the namespace
# this gate always checked), the namespace configured for this project, and
# the namespace of every path the pushed commits change (`neurostrata-mcp
# namespace resolve --pushed`). A failed call blocks the push.
# Check cat's status: a read error after a complete prefix (or before any
# input) must block, not gate on a partial set of refs.
if ! PUSH_REFS=$(cat); then
    echo "error: could not read the refs git passed to this hook — gate NOT run for this push" >&2
    exit 1
fi
FOLDER_NAMESPACE=$(basename "$(git rev-parse --show-toplevel)")
PUSHED_NAMESPACES=$(printf '%s\n' "$PUSH_REFS" | neurostrata-mcp namespace resolve --pushed) || {
    if neurostrata-mcp namespace resolve --help 2>/dev/null | grep -q -- '--pushed'; then
        echo "error: neurostrata-mcp namespace resolve --pushed failed — gate NOT run for this push" >&2
    else
        echo "error: neurostrata-mcp namespace resolve --pushed failed — gate NOT run for this push (neurostrata-mcp is too old for this hook; upgrade it)" >&2
    fi
    exit 1
}
GATE_NAMESPACES=("$FOLDER_NAMESPACE")
# An option-like or empty basename would change how `task gate` parses the
# call, so it is dropped; hidden directories such as `.worktrees` are valid
# namespaces. `--pushed` already contributes the resolved project namespace.
if [ -z "$FOLDER_NAMESPACE" ] || [[ "$FOLDER_NAMESPACE" == -* ]]; then
    GATE_NAMESPACES=()
fi
while IFS= read -r ns; do
    [ -n "$ns" ] || continue
    # An option-like name would be parsed as a `task gate` option, blocking
    # the push; it is never a valid namespace. Drop it here too, so a value
    # emitted by an older --pushed cannot reach the gate.
    [[ "$ns" == -* ]] && continue
    seen=0
    for g in "${GATE_NAMESPACES[@]}"; do
        [ "$g" = "$ns" ] && seen=1
    done
    [ $seen -eq 1 ] || GATE_NAMESPACES+=("$ns")
done <<< "$PUSHED_NAMESPACES"
if [ ${#GATE_NAMESPACES[@]} -eq 0 ]; then
    echo "error: no namespace could be resolved for this push — gate NOT run for this push" >&2
    exit 1
fi

# ── NeuroStrata gate (required) ────────────────────────────────────────────
# --strict maps an unavailable database to a blocking exit too, so a 1
# below is always a verdict: violations, or a database that could not be
# checked under --strict. The hook blocks on the verdict code only.
for GATE_NAMESPACE in "${GATE_NAMESPACES[@]}"; do
    neurostrata-mcp task gate "$GATE_NAMESPACE" --strict
    code=$?
    if [ $code -eq 1 ]; then
        echo "Push blocked: resolve the tasks above" >&2
        exit 1
    fi
    if [ $code -ne 0 ]; then
        echo "error: neurostrata-mcp task gate exited $code — the gate could NOT run for this push" >&2
        exit 1
    fi
done

# ── project guards (add yours here) ────────────────────────────────────────
# Add the path of each local guard; it runs before every push on every host.
# A guard that belongs here does NOT need a CI workflow to be real.
PROJECT_GATES=(
    # Task-coverage gate: blocks pushes when changed docs contain work-item
    # language without a NeuroStrata task ID citation.
    ./scripts/task-coverage-gate.sh
    # ./scripts/rules-gate.sh
)

if [ ${#PROJECT_GATES[@]} -gt 0 ]; then
    for g in "${PROJECT_GATES[@]}"; do
        [ -f "$g" ] || { echo "task-coverage-gate: guard $g missing — skipping" >&2; continue; }
        "$g" || { echo "Push blocked: $g failed" >&2; exit 1; }
    done
fi

exit 0   # the gate passed and all project guards passed
# neurostrata-hook-sha256: e959754763e6e392d7ba87078c4b2bad18f9110daec0b2684c3e194088c65f5c
