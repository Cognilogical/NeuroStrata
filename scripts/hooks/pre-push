#!/bin/bash
# NeuroStrata pre-push hook: (1) upstream-push guard, (2) task gate.
#
# Install once with:  bash scripts/install-hooks.sh
# The installer copies this file into the directory git actually runs
# hooks from (core.hooksPath if set, otherwise the common git dir's
# hooks/ — shared by all worktrees of the clone). Safe to re-run.
#
# ── Guard 1: upstream-push guard (Anthropic-Memory Parity, Task 0.2) ──
# This fork's venue rule: nothing is pushed to upstream
# Cognilogical/NeuroStrata without Pratik's explicit per-action
# consent. The guard is mechanical, not prose: it rejects (exit 1) any
# push whose remote URL's owner/repo path is Cognilogical/NeuroStrata,
# in any common form and on any host:
#   https://github.com/Cognilogical/NeuroStrata[.git]
#   git@github.com:Cognilogical/NeuroStrata.git
#   ssh://git@github.com/Cognilogical/NeuroStrata[.git]
# Matching is on the path segment after the host, case-insensitive, so
# a mirror or proxy host carrying that path is rejected too. The fork
# (pratik-saptarshi/NeuroStrata) and every other remote pass. The
# guard runs first and unconditionally — before the task gate below,
# and whether or not neurostrata-mcp is installed — and there is no
# skip variable for it. Git calls this hook as: pre-push <remote-name>
# <remote-url>, with ref lines on stdin (the guard does not read stdin).

_ns_remote_name="${1:-}"
_ns_remote_url="${2:-}"
if [ -n "$_ns_remote_url" ]; then
    # Normalise: lowercase; strip scheme; strip userinfo; turn the
    # scp-style host:path separator into host/path; strip trailing
    # slash and a single trailing .git.
    _ns_path=$(printf '%s' "$_ns_remote_url" | tr '[:upper:]' '[:lower:]')
    case "$_ns_path" in
        *://*) _ns_path="${_ns_path#*://}" ;;
    esac
    case "$_ns_path" in
        *@*) _ns_path="${_ns_path#*@}" ;;
    esac
    # scp-style "host:owner/repo": replace the first ':' with '/'
    # (pure parameter expansion — no external tools beyond git's
    # usual shell environment).
    case "$_ns_path" in
        *:*/*) _ns_path="${_ns_path%%:*}/${_ns_path#*:}" ;;
    esac
    _ns_path="${_ns_path%/}"
    case "$_ns_path" in
        *.git) _ns_path="${_ns_path%.git}" ;;
    esac
    case "$_ns_path" in
        */cognilogical/neurostrata|cognilogical/neurostrata)
            echo "Push blocked by upstream-push guard: remote '${_ns_remote_name}' points at upstream Cognilogical/NeuroStrata (${_ns_remote_url})." >&2
            echo "Venue rule: nothing is pushed to upstream without Pratik's explicit per-action consent. Push to the fork (pratik-saptarshi/NeuroStrata) instead." >&2
            exit 1
            ;;
    esac
fi
unset _ns_remote_name _ns_remote_url _ns_path

# ── Guard 2: NeuroStrata task gate ────────────────────────────────────
# Scaffolded by neurostrata-bootstrap / task_setup.
# The hook IS the gate. It runs on every push on ANY git host, so it is
# the required default; CI is vendor-specific and only a defense-in-depth
# extra. (`neurostrata-mcp hooks install` writes a hook into the
# directory git actually runs hooks from, core.hooksPath honored; the
# scaffolded hook text it writes — and that hook hygiene auto-installs
# over a stale copy — carries the same Guard 1 executable guard above,
# so either install path, and any hygiene pass, retains the guard.)

command -v neurostrata-mcp >/dev/null 2>&1 || { echo "warning: neurostrata-mcp not found — gate NOT run for this push" >&2; exit 0; }
if [ "$NEUROSTRATA_SKIP_GATE" = "1" ]; then
    echo "NeuroStrata task gate: skipped (NEUROSTRATA_SKIP_GATE=1) — the gate did NOT run for this push" >&2
    exit 0
fi

NAMESPACE=$(basename "$(git rev-parse --show-toplevel)")

# ── NeuroStrata gate (required) ────────────────────────────────────────────
# --strict maps an unavailable database to a blocking exit too, so a 1
# below is always a verdict: violations, or a database that could not be
# checked under --strict. The hook blocks on the verdict code only.
neurostrata-mcp task gate "$NAMESPACE" --strict
code=$?
if [ $code -eq 1 ]; then
    echo "Push blocked: resolve the tasks above, or NEUROSTRATA_SKIP_GATE=1 git push" >&2
    exit 1
fi
# A 2 here is never a verdict: under --strict the gate itself exits
# only 0 or 1, so a 2 means the binary that answered was stale,
# foreign, or died before it could report. Announced, never silent —
# and it still does not block (0 and 2 pass, per the exit line below).
if [ $code -eq 2 ]; then
    echo "warning: neurostrata-mcp task gate exited 2 — the gate could NOT run for this push; proceeding without it" >&2
fi

# ── project guards (add yours here) ────────────────────────────────────────
# Add the path of each local guard; it runs before every push on every host.
# A guard that belongs here does NOT need a CI workflow to be real.
PROJECT_GATES=(
    # Task-coverage gate: blocks pushes when changed docs contain work-item
    # language without a NeuroStrata task ID citation.
    ./scripts/task-coverage-gate.sh
    # ./scripts/rules-gate.sh
)

if [ ${#PROJECT_GATES[@]} -gt 0 ]; then
    for g in "${PROJECT_GATES[@]}"; do
        [ -f "$g" ] || { echo "task-coverage-gate: guard $g missing — skipping" >&2; continue; }
        "$g" || { echo "Push blocked: $g failed" >&2; exit 1; }
    done
fi

exit 0   # 0 and 2 both pass here unless --strict flips 2 to blocking
