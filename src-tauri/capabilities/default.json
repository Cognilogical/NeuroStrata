{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "^vscode://.*" },
        { "url": "^cursor://.*" },
        { "url": "^https?://.*" }
      ]
    }
  ]
}
